  "cover": "",
  "content": "<style>\n  .prompt-guide {\n    max-width: 1200px;\n    margin: 0 auto;\n    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;\n    color: #1a1a1a;\n    line-height: 1.6;\n  }\n  .guide-header {\n    text-align: center;\n    margin-bottom: 48px;\n    padding: 40px 20px;\n    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\n    border-radius: 16px;\n    color: white;\n  }\n  .guide-header h1 {\n    font-size: 2.5rem;\n    margin: 0 0 16px 0;\n    font-weight: 700;\n  }\n  .guide-header p {\n    font-size: 1.1rem;\n    opacity: 0.95;\n    max-width: 600px;\n    margin: 0 auto;\n  }\n  .rules-container {\n    display: flex;\n    flex-direction: column;\n    gap: 32px;\n  }\n  .rule-card {\n    background: #ffffff;\n    border-radius: 16px;\n    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);\n    overflow: hidden;\n    transition: transform 0.2s ease, box-shadow 0.2s ease;\n    border: 1px solid #e8e8e8;\n  }\n  .rule-card:hover {\n    transform: translateY(-2px);\n    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.12);\n  }\n  .rule-header {\n    display: flex;\n    align-items: center;\n    gap: 16px;\n    padding: 20px 24px;\n    background: linear-gradient(90deg, #f8f9fa 0%, #ffffff 100%);\n    border-bottom: 1px solid #e8e8e8;\n  }\n  .rule-number {\n    width: 48px;\n    height: 48px;\n    border-radius: 50%;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-weight: 700;\n    font-size: 1.2rem;\n    color: white;\n    flex-shrink: 0;\n  }\n  .rule-number.anti-spam {\n    background: linear-gradient(135deg, #ff6b6b 0%, #ee5a5a 100%);\n  }\n  .rule-number.editing {\n    background: linear-gradient(135deg, #4ecdc4 0%, #44a08d 100%);\n  }\n  .rule-number.text {\n    background: linear-gradient(135deg, #a8edea 0%, #fed6e3 100%);\n    color: #333;\n  }\n  .rule-number.style {\n    background: linear-gradient(135deg, #ffecd2 0%, #fcb69f 100%);\n    color: #333;\n  }\n  .rule-info {\n    flex: 1;\n  }\n  .rule-category {\n    display: inline-block;\n    padding: 4px 12px;\n    border-radius: 20px;\n    font-size: 0.75rem;\n    font-weight: 600;\n    text-transform: uppercase;\n    letter-spacing: 0.5px;\n    margin-bottom: 6px;\n  }\n  .rule-category.anti-spam {\n    background: #ffe5e5;\n    color: #c53030;\n  }\n  .rule-category.editing {\n    background: #e6fffa;\n    color: #234e52;\n  }\n  .rule-category.text {\n    background: #faf5ff;\n    color: #553c9a;\n  }\n  .rule-category.style {\n    background: #fffaf0;\n    color: #c05621;\n  }\n  .rule-title {\n    font-size: 1.25rem;\n    font-weight: 600;\n    color: #1a202c;\n    margin: 0;\n  }\n  .rule-content {\n    padding: 24px;\n  }\n  .examples-wrapper {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 20px;\n    margin-bottom: 20px;\n  }\n  @media (max-width: 768px) {\n    .examples-wrapper {\n      grid-template-columns: 1fr;\n    }\n  }\n  .example-box {\n    border-radius: 12px;\n    padding: 16px;\n    position: relative;\n  }\n  .example-box.wrong {\n    background: linear-gradient(135deg, #fff5f5 0%, #fed7d7 100%);\n    border: 2px solid #fc8181;\n  }\n  .example-box.correct {\n    background: linear-gradient(135deg, #f0fff4 0%, #c6f6d5 100%);\n    border: 2px solid #68d391;\n  }\n  .example-label {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    font-weight: 600;\n    font-size: 0.875rem;\n    margin-bottom: 12px;\n  }\n  .example-box.wrong .example-label {\n    color: #c53030;\n  }\n  .example-box.correct .example-label {\n    color: #276749;\n  }\n  .example-icon {\n    font-size: 1.2rem;\n  }\n  .example-text {\n    font-family: 'SF Mono', Monaco, 'Cascadia Code', monospace;\n    font-size: 0.875rem;\n    line-height: 1.6;\n    color: #2d3748;\n    background: rgba(255, 255, 255, 0.7);\n    padding: 12px;\n    border-radius: 8px;\n    word-break: break-word;\n  }\n  .copy-btn {\n    position: absolute;\n    top: 12px;\n    right: 12px;\n    background: rgba(255, 255, 255, 0.9);\n    border: 1px solid #e2e8f0;\n    border-radius: 6px;\n    padding: 6px 12px;\n    font-size: 0.75rem;\n    cursor: pointer;\n    transition: all 0.2s ease;\n    display: flex;\n    align-items: center;\n    gap: 4px;\n  }\n  .copy-btn:hover {\n    background: white;\n    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);\n  }\n  .copy-btn.copied {\n    background: #48bb78;\n    color: white;\n    border-color: #48bb78;\n  }\n  .explanation {\n    background: #f7fafc;\n    border-left: 4px solid #4299e1;\n    padding: 16px 20px;\n    border-radius: 0 8px 8px 0;\n    font-size: 0.95rem;\n    color: #4a5568;\n  }\n  .explanation::before {\n    content: \"💡\";\n    margin-right: 8px;\n  }\n</style>\n\n<div class=\"prompt-guide\">\n  <div class=\"guide-header\">\n    <h1>GPT Image 2 提示词编写指南</h1>\n    <p>本指南总结了编写高质量 GPT Image 2 提示词的核心技巧和常见错误，帮助你生成更精准、更符合预期的图像。</p>\n  </div>\n\n  <div class=\"rules-container\">\n    <div class=\"rule-card\">\n      <div class=\"rule-header\">\n        <div class=\"rule-number anti-spam\">1</div>\n        <div class=\"rule-info\">\n          <span class=\"rule-category anti-spam\">反垃圾规则</span>\n          <h3 class=\"rule-title\">视觉事实优于模糊赞美</h3>\n        </div>\n      </div>\n      <div class=\"rule-content\">\n        <div class=\"examples-wrapper\">\n          <div class=\"example-box wrong\">\n            <div class=\"example-label\">\n              <span class=\"example-icon\">❌</span>\n              <span>错误示例</span>\n            </div>\n            <div class=\"example-text\">A stunning ultra-detailed cinematic masterpiece of a woman in a museum, beautiful, photoreal, 8K, award-winning.</div>\n          </div>\n          <div class=\"example-box correct\">\n            <button class=\"copy-btn\" onclick=\"navigator.clipboard.writeText('Scene: A quiet classical museum gallery in soft afternoon light. Subject: A woman in her 30s standing casually in front of a large oil painting. Important details: Natural smile, realistic skin texture, beige knit sweater...'); this.textContent='✓ 已复制'; this.classList.add('copied'); setTimeout(() => { this.textContent='📋 复制'; this.classList.remove('copied'); }, 2000);\">\n              📋 复制\n            </button>\n            <div class=\"example-label\">\n              <span class=\"example-icon\">✅</span>\n              <span>正确示例</span>\n            </div>\n            <div class=\"example-text\">Scene: A quiet classical museum gallery in soft afternoon light. Subject: A woman in her 30s standing casually in front of a large oil painting. Important details: Natural smile, realistic skin texture, beige knit sweater...</div>\n          </div>\n        </div>\n        <div class=\"explanation\">感叹词不会渲染成像素，用具体的视觉描述替代模糊赞美</div>\n      </div>\n    </div>\n\n    <div class=\"rule-card\">\n      <div class=\"rule-header\">\n        <div class=\"rule-number anti-spam\">2</div>\n        <div class=\"rule-info\">\n          <span class=\"rule-category anti-spam\">反垃圾规则</span>\n          <h3 class=\"rule-title\">风格标签需要视觉目标</h3>\n        </div>\n      </div>\n      <div class=\"rule-content\">\n        <div class=\"examples-wrapper\">\n          <div class=\"example-box wrong\">\n            <div class=\"example-label\">\n              <span class=\"example-icon\">❌</span>\n              <span>错误示例</span>\n            </div>\n            <div class=\"example-text\">minimalist brutalist editorial luxury photoreal cinematic modern premium</div>\n          </div>\n          <div class=\"example-box correct\">\n            <button class=\"copy-btn\" onclick=\"navigator.clipboard.writeText('Cream background, heavy black condensed sans serif, asymmetrical type block, one hero object, generous negative space, studio tabletop lighting.'); this.textContent='✓ 已复制'; this.classList.add('copied'); setTimeout(() => { this.textContent='📋 复制'; this.classList.remove('copied'); }, 2000);\">\n              📋 复制\n            </button>\n            <div class=\"example-label\">\n              <span class=\"example-icon\">✅</span>\n              <span>正确示例</span>\n            </div>\n            <div class=\"example-text\">Cream background, heavy black condensed sans serif, asymmetrical type block, one hero object, generous negative space, studio tabletop lighting.</div>\n          </div>\n        </div>\n        <div class=\"explanation\">堆砌风格关键词不如描述具体的视觉元素</div>\n      </div>\n    </div>\n\n    <div class=\"rule-card\">\n      <div class=\"rule-header\">\n        <div class=\"rule-number anti-spam\">3</div>\n        <div class=\"rule-info\">\n          <span class=\"rule-category anti-spam\">反垃圾规则</span>\n          <h3 class=\"rule-title\">说具体的事物</h3>\n        </div>\n      </div>\n      <div class=\"rule-content\">\n        <div class=\"examples-wrapper\">\n          <div class=\"example-box wrong\">\n            <div class=\"example-label\">\n              <span class=\"example-icon\">❌</span>\n              <span>错误示例</span>\n            </div>\n            <div class=\"example-text\">Make it more premium, more realistic, more stylish</div>\n          </div>\n          <div class=\"example-box correct\">\n            <button class=\"copy-btn\" onclick=\"navigator.clipboard.writeText('Replace the white dining chairs with natural oak wooden chairs. Preserve the camera angle and lighting.'); this.textContent='✓ 已复制'; this.classList.add('copied'); setTimeout(() => { this.textContent='📋 复制'; this.classList.remove('copied'); }, 2000);\">\n              📋 复制\n            </button>\n            <div class=\"example-label\">\n              <span class=\"example-icon\">✅</span>\n              <span>正确示例</span>\n            </div>\n            <div class=\"example-text\">Replace the white dining chairs with natural oak wooden chairs. Preserve the camera angle and lighting.</div>\n          </div>\n        </div>\n        <div class=\"explanation\">直接说出要什么，而不是用形容词描述期望</div>\n      </div>\n    </div>\n\n    <div class=\"rule-card\">\n      <div class=\"rule-header\">\n        <div class=\"rule-number editing\">4</div>\n        <div class=\"rule-info\">\n          <span class=\"rule-category editing\">编辑技巧</span>\n          <h3 class=\"rule-title\">将更改与保留分开</h3>\n        </div>\n      </div>\n      <div class=\"rule-content\">\n        <div class=\"examples-wrapper\">\n          <div class=\"example-box wrong\">\n            <div class=\"example-label\">\n              <span class=\"example-icon\">❌</span>\n              <span>错误示例</span>\n            </div>\n            <div class=\"example-text\">Make it better and keep the good parts</div>\n          </div>\n          <div class=\"example-box correct\">\n            <button class=\"copy-btn\" onclick=\"navigator.clipboard.writeText('Change: Replace the background with a sunset beach. Preserve: face, identity, pose, lighting, framing. Keep everything else the same.'); this.textContent='✓ 已复制'; this.classList.add('copied'); setTimeout(() => { this.textContent='📋 复制'; this.classList.remove('copied'); }, 2000);\">\n              📋 复制\n            </button>\n            <div class=\"example-label\">\n              <span class=\"example-icon\">✅</span>\n              <span>正确示例</span>\n            </div>\n            <div class=\"example-text\">Change: Replace the background with a sunset beach. Preserve: face, identity, pose, lighting, framing. Keep everything else the same.</div>\n          </div>\n        </div>\n        <div class=\"explanation\">明确列出要改什么、要保留什么</div>\n      </div>\n    </div>\n\n    <div class=\"rule-card\">\n      <div class=\"rule-header\">\n        <div class=\"rule-number editing\">5</div>\n        <div class=\"rule-info\">\n          <span class=\"rule-category editing\">编辑技巧</span>\n          <h3 class=\"rule-title\">每次只做一个修订</h3>\n        </div>\n      </div>\n      <div class=\"rule-content\">\n        <div class=\"examples-wrapper\">\n          <div class=\"example-box wrong\">\n            <div class=\"example-label\">\n              <span class=\"example-icon\">❌</span>\n              <span>错误示例</span>\n            </div>\n            <div class=\"example-text\">Make it more premium, fix the text, change the outfit, improve the background, and keep everything.</div>\n          </div>\n          <div class=\"example-box correct\">\n            <button class=\"copy-btn\" onclick=\"navigator.clipboard.writeText('Make the light warmer. Remove the extra chair on the left. Restore the original wall texture. Keep everything else the same.'); this.textContent='✓ 已复制'; this.classList.add('copied'); setTimeout(() => { this.textContent='📋 复制'; this.classList.remove('copied'); }, 2000);\">\n              📋 复制\n            </button>\n            <div class=\"example-label\">\n              <span class=\"example-icon\">✅</span>\n              <span>正确示例</span>\n            </div>\n            <div class=\"example-text\">Make the light warmer. Remove the extra chair on the left. Restore the original wall texture. Keep everything else the same.</div>\n          </div>\n        </div>\n        <div class=\"explanation\">小步迭代比一次大改效果更好</div>\n      </div>\n    </div>\n\n    <div class=\"rule-card\">\n      <div class=\"rule-header\">\n        <div class=\"rule-number text\">6</div>\n        <div class=\"rule-info\">\n          <span class=\"rule-category text\">文字渲染</span>\n          <h3 class=\"rule-title\">将文本当作排版处理</h3>\n        </div>\n      </div>\n      <div class=\"rule-content\">\n        <div class=\"examples-wrapper\">\n          <div class=\"example-box wrong\">\n            <div class=\"example-label\">\n              <span class=\"example-icon\">❌</span>\n              <span>错误示例</span>\n            </div>\n            <div class=\"example-text\">Add some text \"Hello World\" to the image</div>\n          </div>\n          <div class=\"example-box correct\">\n            <button class=\"copy-btn\" onclick=\"navigator.clipboard.writeText('Top banner: bold sans-serif, all caps, tracking +50, white text on navy blue background, centered, generous padding. Text reads: HELLO WORLD'); this.textContent='✓ 已复制'; this.classList.add('copied'); setTimeout(() => { this.textContent='📋 复制'; this.classList.remove('copied'); }, 2000);\">\n              📋 复制\n            </button>\n            <div class=\"example-label\">\n              <span class=\"example-icon\">✅</span>\n              <span>正确示例</span>\n            </div>\n            <div class=\"example-text\">Top banner: bold sans-serif, all caps, tracking +50, white text on navy blue background, centered, generous padding. Text reads: HELLO WORLD</div>\n          </div>\n        </div>\n        <div class=\"explanation\">描述文字的排版样式（字体、大小、颜色、位置）而非仅内容</div>\n      </div>\n    </div>\n\n    <div class=\"rule-card\">\n      <div class=\"rule-header\">\n        <div class=\"rule-number style\">7</div>\n        <div class=\"rule-info\">\n          <span class=\"rule-category style\">风格控制</span>\n          <h3 class=\"rule-title\">使用参考图像</h3>\n        </div>\n      </div>\n      <div class=\"rule-content\">\n        <div class=\"examples-wrapper\">\n          <div class=\"example-box wrong\">\n            <div class=\"example-label\">\n              <span class=\"example-icon\">❌</span>\n              <span>错误示例</span>\n            </div>\n            <div class=\"example-text\">Make it look like a famous painting style</div>\n          </div>\n          <div class=\"example-box correct\">\n            <button class=\"copy-btn\" onclick=\"navigator.clipboard.writeText('Style reference: Edward Hopper. Lighting: dramatic side light, long shadows. Mood: urban isolation. Color palette: muted earth tones with selective warm highlights.'); this.textContent='✓ 已复制'; this.classList.add('copied'); setTimeout(() => { this.textContent='📋 复制'; this.classList.remove('copied'); }, 2000);\">\n              📋 复制\n            </button>\n            <div class=\"example-label\">\n              <span class=\"example-icon\">✅</span>\n              <span>正确示例</span>\n            </div>\n            <div class=\"example-text\">Style reference: Edward Hopper. Lighting: dramatic side light, long shadows. Mood: urban isolation. Color palette: muted earth tones with selective warm highlights.</div>\n          </div>\n        </div>\n        <div class=\"explanation\">引用具体的艺术家、作品或视觉风格，并描述其关键特征</div>\n      </div>\n    </div>\n\n    <div class=\"rule-card\">\n      <div class=\"rule-header\">\n        <div class=\"rule-number style\">8</div>\n        <div class=\"rule-info\">\n          <span class=\"rule-category style\">风格控制</span>\n          <h3 class=\"rule-title\">结构化提示词</h3>\n        </div>\n      </div>\n      <div class=\"rule-content\">\n        <div class=\"examples-wrapper\">\n          <div class=\"example-box wrong\">\n            <div class=\"example-label\">\n              <span class=\"example-icon\">❌</span>\n              <span>错误示例</span>\n            </div>\n            <div class=\"example-text\">A beautiful sunset over mountains with a lake and some trees in the foreground, very colorful and dramatic</div>\n          </div>\n          <div class=\"example-box correct\">\n            <button class=\"copy-btn\" onclick=\"navigator.clipboard.writeText('Subject: Alpine lake at golden hour. Composition: Rule of thirds, mountains in background (top third), lake reflection (middle), pine trees silhouette (bottom). Lighting: Warm orange and pink sky, soft rim lighting on peaks. Atmosphere: serene, majestic. Technical: 16:9 aspect ratio, landscape orientation.'); this.textContent='✓ 已复制'; this.classList.add('copied'); setTimeout(() => { this.textContent='📋 复制'; this.classList.remove('copied'); }, 2000);\">\n              📋 复制\n            </button>\n            <div class=\"example-label\">\n              <span class=\"example-icon\">✅</span>\n              <span>正确示例</span>\n            </div>\n            <div class=\"example-text\">Subject: Alpine lake at golden hour. Composition: Rule of thirds, mountains in background (top third), lake reflection (middle), pine trees silhouette (bottom). Lighting: Warm orange and pink sky, soft rim lighting on peaks. Atmosphere: serene, majestic. Technical: 16:9 aspect ratio, landscape orientation.</div>\n          </div>\n        </div>\n        <div class=\"explanation\">使用分类标签（Subject/Composition/Lighting/Atmosphere/Technical）组织提示词</div>\n      </div>\n    </div>\n  </div>\n</div>"
}
